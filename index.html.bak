<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Ambati SaiSurya | Software developer</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,500&family=Inter+Tight:wght@400;500&display=swap" rel="stylesheet">
<style>
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);
--bg:#f3f5f2;--ink:#14171c;--sub:#586070;--line:#dadfd9;--acc:#1f4fd1;--accbg:#e6ecfb;--card:#fff;--ok:#1a7a46;--err:#b3261e}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0f1216;--ink:#ecebe6;--sub:#a0a7b3;--line:#272c35;--acc:#86a9ff;--accbg:#1b2540;--card:#161a21;--ok:#5fd08d;--err:#ff8a80}}
:root[data-theme="dark"]{--bg:#0f1216;--ink:#ecebe6;--sub:#a0a7b3;--line:#272c35;--acc:#86a9ff;--accbg:#1b2540;--card:#161a21;--ok:#5fd08d;--err:#ff8a80}
*{box-sizing:border-box}
html{scroll-padding-top:calc(env(safe-area-inset-top,0px) + 68px);scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--ink);font:400 17px/1.65 "Newsreader",Georgia,serif}
a{color:inherit}a:focus-visible,button:focus-visible,input:focus-visible,textarea:focus-visible{outline:2px solid var(--acc);outline-offset:3px}
.w{max-width:1040px;margin:0 auto;padding:0 clamp(18px,5vw,40px)}
.ui{font-family:"Inter Tight",Arial,sans-serif}
nav{position:sticky;top:env(safe-area-inset-top,0px);background:var(--bg);border-bottom:1px solid var(--line);z-index:5}
nav .w{display:flex;justify-content:space-between;align-items:center;height:60px;font:500 14px "Inter Tight",Arial,sans-serif}
nav div{display:flex;gap:clamp(12px,3vw,26px);align-items:center}
nav a{text-decoration:none;color:var(--sub)}nav a:hover{color:var(--ink)}
nav a.cta{color:var(--bg);background:var(--ink);padding:8px 14px;border-radius:8px}
.hero{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(0,1fr);gap:clamp(28px,6vw,72px);align-items:center;padding:clamp(40px,8vw,88px) 0}
.pill{display:inline-block;font:500 13px "Inter Tight",Arial,sans-serif;background:var(--accbg);color:var(--acc);padding:6px 12px;border-radius:99px;margin-bottom:18px}
h1{font:500 clamp(40px,7vw,72px)/1.03 "Newsreader",Georgia,serif;letter-spacing:-.02em;margin:0 0 18px}
.lede{font-size:clamp(18px,2.2vw,20px);color:var(--sub);max-width:33em;margin:0 0 26px}
.btns{display:flex;gap:10px;flex-wrap:wrap;font:500 15px "Inter Tight",Arial,sans-serif}
.btn{text-decoration:none;padding:12px 20px;border-radius:8px;border:1px solid var(--ink);background:transparent;color:var(--ink);cursor:pointer;font:inherit}
.btn.p{background:var(--ink);color:var(--bg)}.btn:hover{border-color:var(--acc)}
.facts-unused{display:flex;gap:28px;margin-top:30px;font:400 14px "Inter Tight",Arial,sans-serif;color:var(--sub)}
.facts b{display:block;font:500 26px "Newsreader",Georgia,serif;color:var(--ink);line-height:1.1}
.det{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px 24px;margin:0 0 28px;padding:18px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);max-width:34em}
.det dt{font:400 13px "Inter Tight",Arial,sans-serif;color:var(--sub)}
.det dd{margin:0;font-size:17px;overflow-wrap:anywhere}
.det a{text-decoration:none}.det a:hover{color:var(--acc)}
.frame{position:relative;border-radius:16px;background:var(--accbg);padding:10px;transform:rotate(1.5deg)}
.ph{width:100%;aspect-ratio:1;object-fit:cover;border-radius:10px;display:block;transform:rotate(-1.5deg)}
section{padding:clamp(36px,6vw,64px) 0}
.head{display:flex;justify-content:space-between;align-items:baseline;gap:16px;margin-bottom:24px}
h2{font:500 clamp(28px,4vw,36px)/1.15 "Newsreader",Georgia,serif;margin:0;letter-spacing:-.01em}
.head span{font:400 14px "Inter Tight",Arial,sans-serif;color:var(--sub)}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,290px),1fr));gap:16px}
.card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:22px;display:flex;flex-direction:column;gap:10px;transition:border-color .2s,transform .2s}
.card:hover{border-color:var(--acc);transform:translateY(-2px)}
.card h3{font:500 21px/1.25 "Newsreader",Georgia,serif;margin:0}
.card p{margin:0;color:var(--sub);font-size:16px}
.card .k{font:500 13px "Inter Tight",Arial,sans-serif;color:var(--acc)}
.tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:auto;padding-top:6px}
.tag{font:400 12.5px "Inter Tight",Arial,sans-serif;padding:4px 10px;border-radius:99px;background:var(--accbg);color:var(--acc)}
.card.sk .tag{background:var(--bg);color:var(--ink);border:1px solid var(--line)}
.big{font:500 30px/1 "Newsreader",Georgia,serif}
.contact{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.2fr);gap:clamp(20px,5vw,56px)}
.contact h2{margin-bottom:12px}
.contact .info p{color:var(--sub);margin:0 0 14px}
.contact .info a{color:var(--ink)}
form{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:24px;display:grid;gap:14px}
label{font:500 14px "Inter Tight",Arial,sans-serif;display:grid;gap:6px}
input,textarea{font:400 16px "Inter Tight",Arial,sans-serif;color:var(--ink);background:var(--bg);border:1px solid var(--line);border-radius:8px;padding:11px 12px;width:100%}
textarea{min-height:130px;resize:vertical}
input:focus,textarea:focus{border-color:var(--acc)}
.msg{font:400 14px "Inter Tight",Arial,sans-serif;min-height:20px;margin:0}
.msg.e{color:var(--err)}.msg.s{color:var(--ok)}
footer{border-top:1px solid var(--line);padding:24px 0 40px;font:400 14px "Inter Tight",Arial,sans-serif;color:var(--sub)}
@media (max-width:760px){.hero,.contact{grid-template-columns:1fr}.frame{max-width:280px;order:-1}nav div a:not(.cta):nth-child(n+3){display:none}}
@media (prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}
h1{white-space:nowrap;font-size:clamp(34px,5vw,60px)!important}
@media (max-width:760px){h1{font-size:clamp(30px,9vw,54px)!important}}
.tw{position:relative;display:inline-block;padding-right:8px}
.tt{display:inline-block;clip-path:inset(-10% 100% -25% 0);animation:rev 2.2s steps(15,end) .4s both}
.cur{position:absolute;top:8%;bottom:8%;left:0;width:3px;background:var(--acc);animation:mv 2.2s steps(15,end) .4s both,blink 1s steps(1) 2.6s infinite}
@keyframes rev{to{clip-path:inset(-10% -5% -25% 0)}}
@keyframes mv{to{left:calc(100% - 8px)}}
@keyframes blink{50%{opacity:0}}
@media (prefers-reduced-motion:reduce){.tt{animation:none;clip-path:none}.cur{animation:none;left:calc(100% - 8px)}}
.mono{width:48px;height:48px;border-radius:10px;background:var(--accbg);color:var(--acc);display:grid;place-items:center;font:500 14px "Inter Tight",Arial,sans-serif;margin-bottom:4px}
a.tag{text-decoration:none}a.tag:hover{background:var(--acc);color:var(--card)}
</style>
</head>
<body>
<nav><div class="w"><a href="#top" style="color:var(--ink);font-weight:500">Ambati SaiSurya</a><div><a href="#work">Projects</a><a href="#skills">Skills</a><a href="#certifications">Certifications</a><a href="#education">Education</a><a href="#activity">Activities</a><a class="cta" href="#contact">Contact</a></div></div></nav>
<main id="top">
<div class="w"><header class="hero">
<div>
<span class="pill">B.Tech CSE, KL University, graduated 2026</span>
<h1 aria-label="Ambati SaiSurya"><span class="tw" aria-hidden="true"><span class="tt">Ambati SaiSurya</span><i class="cur"></i></span></h1>
