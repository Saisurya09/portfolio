<div class="w"><section id="contact"><div class="contact">
<div class="info"><h2>Let's talk</h2><p>Have a role or project in mind? Write to me here, or use my email or phone directly.</p>
<p><a href="mailto:saisuryaambati0907@gmail.com">saisuryaambati0907@gmail.com</a></p>
<p><a href="tel:+919059716605">+91 90597 16605</a></p>
<button class="btn" type="button" id="copy">Copy email</button></div>
<form id="f" novalidate>
<label>Your name<input id="n" autocomplete="name" placeholder="Priya Sharma"></label>
<label>Your email<input id="e" type="email" autocomplete="email" placeholder="priya@company.com"></label>
<label>Message<textarea id="m" placeholder="Tell me about the role or project"></textarea></label>
<button class="btn p" type="submit">Send message</button>
<input type="checkbox" id="bot" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px" aria-hidden="true">
<p class="msg" id="s" role="status"></p>
</form></div></section></div>
</main>
<footer><div class="w">Ambati SaiSurya, 2026</div></footer>
<script>
(function(){
var TO="saisuryaambati0907@gmail.com",f=document.getElementById('f'),s=document.getElementById('s');
function say(t,c){s.textContent=t;s.className='msg '+(c||'')}
function val(){
  var n=document.getElementById('n').value.trim(),e=document.getElementById('e').value.trim(),m=document.getElementById('m').value.trim();
  if(!n){say('Enter your name.','e');return null}
  if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(e)){say('Enter a valid email address.','e');return null}
  if(m.length<10){say('Write a short message, at least 10 characters.','e');return null}
  return {n:n,e:e,m:m};
}
var KEY="YOUR_ACCESS_KEY";
f.addEventListener('submit',function(ev){
  ev.preventDefault();var d=val();if(!d)return;
  if(document.getElementById('bot').checked)return;
  var btn=f.querySelector('button[type=submit]');btn.textContent='Sending...';say('');
  fetch('https://api.web3forms.com/submit',{method:'POST',headers:{'Content-Type':'application/json',Accept:'application/json'},
    body:JSON.stringify({access_key:KEY,subject:'Portfolio message from '+d.n,name:d.n,email:d.e,message:d.m,botcheck:''})})
  .then(function(r){return r.json()}).then(function(j){
    if(j.success){f.reset();say('Message sent. I will reply to your email soon.','s')}else{say('Could not send. Email me directly at '+TO+'.','e')}
  }).catch(function(){say('Could not send. Email me directly at '+TO+'.','e')})
  .then(function(){btn.textContent='Send message'});
});
document.getElementById('copy').onclick=function(){
  var b=this;
  function ok(){b.textContent='Copied';setTimeout(function(){b.textContent='Copy email'},1800)}
  try{navigator.clipboard.writeText(TO).then(ok,function(){b.textContent=TO})}catch(x){b.textContent=TO}
};
})();
</script>
</body>
</html>
